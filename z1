<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>About Me | Developer Portfolio</title>

  <style>

    /* ---------- Global ---------- */

    * {

      margin: 0;

      padding: 0;

      box-sizing: border-box;

      font-family: "Poppins", "Inter", sans-serif;

    }

    body {

      min-height: 100vh;

      background: linear-gradient(120deg, #0b0f2c 0%, #111536 50%, #1b1b45 100%);

      color: #fff;

      display: flex;

      flex-direction: column;

      align-items: center;

      justify-content: center;

      padding: 60px 20px;

    }

    /* ---------- About Section ---------- */

    .about-container {

      background: rgba(255, 255, 255, 0.05);

      border: 1px solid rgba(255, 255, 255, 0.1);

      backdrop-filter: blur(20px);

      border-radius: 20px;

      padding: 40px;

      max-width: 900px;

      width: 100%;

      box-shadow: 0 0 40px rgba(108, 99, 255, 0.3);

      transition: all 0.3s ease;

    }

    .about-container:hover {

      box-shadow: 0 0 60px rgba(168, 108, 254, 0.4);

    }

    .heading {

      display: inline-block;

      background: linear-gradient(90deg, #a86cfe, #6c63ff);

      padding: 10px 24px;

      border-radius: 12px;

      font-weight: 600;

      font-size: 22px;

      margin-bottom: 24px;

      letter-spacing: 0.5px;

      box-shadow: 0 4px 10px rgba(108, 99, 255, 0.4);

    }

    .about-content {

      display: flex;

      flex-wrap: wrap;

      align-items: center;

      justify-content: space-between;

      gap: 30px;

    }

    .about-text {

      flex: 1;

      min-width: 260px;

    }

    .about-text h2 {

      font-size: 28px;

      margin-bottom: 10px;

      color: #c9c9ff;

    }

    .about-text p {

      font-size: 16px;

      line-height: 1.7;

      color: #d9d9f9;

    }

    .about-photo {

      width: 180px;

      height: 180px;

      border-radius: 50%;

      background: linear-gradient(135deg, #00bcd4, #1976d2);

      box-shadow: 0 0 25px rgba(0, 188, 212, 0.5);

      display: flex;

      align-items: center;

      justify-content: center;

      overflow: hidden;

    }

    .about-photo img {

      width: 95%;

      height: 95%;

      border-radius: 50%;

      object-fit: cover;

    }

    /* ---------- Bottom Card ---------- */

    .skills-card {

      margin-top: 50px;

      background: linear-gradient(135deg, #9a7bff, #7c5cff, #6a4cff);

      padding: 30px;

      border-radius: 30px;

      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);

      text-align: center;

      color: #fff;

    }

    .skills-card h3 {

      margin-bottom: 12px;

      font-size: 22px;

    }

    .skills-card p {

      font-size: 15px;

      color: #e0d8ff;

    }

    /* ---------- Responsive ---------- */

    @media (max-width: 768px) {

      .about-content {

        flex-direction: column-reverse;

        text-align: center;

      }

      .about-photo {

        margin-bottom: 20px;

      }

    }

  </style>

</head>

<body>

  <section class="about-container">

    <div class="heading">About Me</div>

    <div class="about-content">

      <div class="about-text">

        <h2>Hi, I’m Archita 👩‍💻</h2>

        <p>

          A passionate MERN Stack Developer focused on crafting clean and user-friendly

          web experiences. I love turning ideas into code and bringing designs to life

          with modern technologies like React, Node.js, and MongoDB.

        </p>

      </div>

      <div class="about-photo">

        <!-- Replace with your photo -->

        <img src="https://via.placeholder.com/180" alt="Archita Profile Photo" />

      </div>

    </div>

    <div class="skills-card">

      <h3>Skills & Tech Stack</h3>

      <p>

        React ⚛️ | Node.js 🌐 | Express 🚀 | MongoDB 🍃 | JavaScript | UI/UX Design

      </p>

    </div>

  </section>

</body>

</html>



